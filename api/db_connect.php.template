<?php
// Robo AI Paths - Database Connection Template
// Fill in your credentials below

$db_host = 'localhost';             // Usually localhost on Hostinger
$db_user = 'YOUR_DB_USER';          // Your MySQL Username
$db_pass = 'YOUR_DB_PASSWORD';      // Your MySQL Password
$db_name = 'YOUR_DB_NAME';          // Your MySQL Database Name

$conn = new mysqli($db_host, $db_user, $db_pass, $db_name);

if ($conn->connect_error) {
    error_log("Database Connection failed: " . $conn->connect_error);
} else {
    $conn->set_charset("utf8mb4");
}
